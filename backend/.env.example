PORT=4000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/air_pollution_iot

# Đổi 2 secret này khi deploy thật (vd: openssl rand -hex 32)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=backend
MQTT_PASSWORD=backendpass123

CORS_ORIGIN=http://localhost:5173

# Tuỳ chọn: cấu hình SMTP để gửi email khi có cảnh báo vượt ngưỡng (xem mailService.js).
# Nếu để trống SMTP_HOST, tính năng email tự tắt (chỉ log warn, không lỗi).
# Dùng được với Gmail App Password (smtp.gmail.com, port 465, secure) hoặc Resend/Brevo free tier.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Air Quality Monitor <no-reply@example.com>"
